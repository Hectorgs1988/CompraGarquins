# Frontend
VITE_API_URL=http://localhost:4100
WEB_HOST_PORT=5174
ADMINER_HOST_PORT=8081

# Backend
PORT=4100
API_HOST_PORT=4100
NODE_ENV=development
SESSION_SECRET=change-me
# Puedes poner varios origenes separados por coma.
# Ejemplo: CORS_ORIGIN=http://localhost:5174,http://192.168.1.34:5174
CORS_ORIGIN=http://localhost:5174
# Produccion cross-domain (frontend en Vercel + API en otro dominio)
# same-site recomendado en produccion: none
SESSION_COOKIE_SAME_SITE=lax
# Si SESSION_COOKIE_SAME_SITE=none, secure se fuerza a true en codigo
SESSION_COOKIE_SECURE=false
# Opcional, por defecto vacio
SESSION_COOKIE_DOMAIN=
# Si usas Nginx/Caddy/Traefik delante de Node, activar trust proxy
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# DB: sqlite3 | postgres | mysql2
MYSQL_HOST_PORT=3307
DB_CLIENT=sqlite3
DB_HOST=localhost
DB_PORT=3307
DB_USER=app
DB_PASSWORD=app
DB_NAME=cestagarquins
DB_FILE=./data/cestagarquins.sqlite3
